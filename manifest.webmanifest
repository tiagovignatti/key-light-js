{
  "name": "Key Light",
  "short_name": "Key Light",
  "description": "A key light for video calls. Turn a spare phone, tablet or monitor into a light, a studio for filming yourself, or a light show for music.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["fullscreen", "standalone"],
  "orientation": "any",
